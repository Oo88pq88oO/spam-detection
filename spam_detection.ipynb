    "                        .str.replace(r\"\\s+\", \" \", regex=True) # Somethin like \\n and ...\n",
    "                        #.str.replace(r\"[^\\w\\s]\", \"\", regex=True) # Punctuation Marks\n",
    "                        #.str.replace(r\"\\d+\", \"\", regex=True) # Numbers\n",
