   "source": [
    "params = {\"model__C\": [0.01, 0.1, 0.5, 1, 2, 5, 1.5, 1.8, 1.02]}\n",
    "\n",
    "scoring = {\n",
    "    \"macro_f1\": \"f1_macro\",\n",
    "    \"spam_f1\": make_scorer(f1_score, pos_label=\"spam\"),\n",
    "    \"weighted_f1\": \"f1_weighted\"\n",
    "}\n",
    "\n",
    "cv = StratifiedGroupKFold(\n",
    "    n_splits=4,\n",
    "    shuffle=True,\n",
    "    random_state=42\n",
    ")\n",
    "\n",
    "grid = GridSearchCV(\n",
    "    main_pipeline,\n",
    "    params,\n",
    "    cv=cv,\n",
    "    scoring=scoring,\n",
    "    refit=\"macro_f1\",\n",
    "    return_train_score=True\n",
    ")\n",
    "\n",
    "grid.fit(X_train, y_train, groups=train_groups)\n",
    "best_C = grid.best_params_[\"model__C\"]\n",
    "\n",
    "preprocessor = grid.best_estimator_.named_steps[\"preprocessor\"]\n",
    "\n",
    "X_train_final = preprocessor.transform(X_train)\n",
    "X_test_final = preprocessor.transform(X_test)\n",
    "X_val_final = preprocessor.transform(X_val)\n",
    "\n",
    "print(\"Best C:\", best_C)\n",
    "\n",
    "results = pd.DataFrame(grid.cv_results_)\n",
    "\n",
    "display(results[[\n",
    "    \"param_model__C\",\n",
    "    \"mean_test_macro_f1\",\n",
    "    \"mean_test_spam_f1\",\n",
    "    \"mean_test_weighted_f1\"\n",
    "]].sort_values(\"mean_test_macro_f1\", ascending=False))\n"
   ]
  },
