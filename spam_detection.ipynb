    "\n",
    "\n",
    "def extract_image_count(message):\n",
    "    return len(re.findall(r'<img\\b|\\[image\\]', str(message), re.I))\n",
    "\n",
    "def extract_emoji_count(message):\n",
    "    return emoji.emoji_count(str(message))\n",
    "\n",
    "\n",
    "data[\"image\"] = data[\"Message\"].apply(extract_image_count)\n",
    "data[\"emoji\"] = data[\"Message\"].apply(extract_emoji_count)\n",
    "\n",
    "\n",
    "print(\"Image distribution:\")\n",
    "print(data[\"image\"].value_counts())\n",
    "\n",
    "print(\"Emails containing images:\", (data[\"image\"] > 0).sum())\n",
    "\n",
    "print(\"\\nEmoji distribution:\")\n",
    "print(data[\"emoji\"].value_counts())\n",
    "\n",
    "print(\"Emails containing emojis:\", (data[\"emoji\"] > 0).sum())\n",
    "\n",
    "\n",
    "\n",
    "def plot_feature(feature, title):\n",
    "    emails = data[data[feature] > 0]\n",
    "    counts = emails[\"Spam/Ham\"].value_counts()\n",
    "    counts = counts.reindex([\"ham\", \"spam\"], fill_value=0)\n",
    "\n",
    "    plt.figure(figsize=(7, 5))\n",
    "    plt.bar(counts.index, counts.values)\n",
    "\n",
    "    plt.title(title)\n",
    "    plt.xlabel(\"Email Type\")\n",
    "    plt.ylabel(\"Number of Emails\")\n",
    "\n",
    "    for i, value in enumerate(counts.values):\n",
    "        plt.text(i, value, str(value), ha=\"center\", va=\"bottom\")\n",
    "\n",
    "    plt.show()\n",
    "\n",
    "\n",
    "plot_feature(\"image\", \"Spam vs Ham (Emails containing Images)\")\n",
    "plot_feature(\"emoji\", \"Spam vs Ham (Emails containing Emojis)\")\n"
   ]
  },
