    }
   ],
   "source": [
    "plt.figure(figsize=(10, 5))\n",
    "\n",
    "sns.histplot(\n",
    "    data=data,\n",
    "    x=\"uppercase_ratio\",\n",
    "    hue=\"Spam/Ham\",\n",
    "    stat=\"density\",\n",
    "    common_norm=False,\n",
    "    bins=30,\n",
    "    element=\"step\",\n",
    "    fill=False\n",
    ")\n",
    "\n",
    "plt.title(\"Uppercase Ratio Distribution: Spam vs Ham\")\n",
    "plt.xlabel(\"Uppercase Ratio\")\n",
    "plt.ylabel(\"Density\")\n",
    "\n",
    "plt.show()\n"
   ]
