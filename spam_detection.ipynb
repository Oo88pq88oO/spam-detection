    "data = results_df.sort_values(\"F1\")\n",
    "\n",
    "plt.figure(figsize=(10, 7))\n",
    "\n",
    "plt.scatter(data[\"F1\"], data.index, s=90)\n",
    "\n",
    "for i, (name, row) in enumerate(data.iterrows()):\n",
    "    plt.text(row[\"F1\"] + 0.000005, i, f'{row[\"F1\"]:.6f}',\n",
    "             va=\"center\", fontsize=9)\n",
    "\n",
    "plt.xlim(\n",
    "    data[\"F1\"].min() - 0.0001,\n",
    "    data[\"F1\"].max() + 0.00015\n",
    ")\n",
    "\n",
    "plt.xlabel(\"F1 Score\")\n",
    "plt.title(\"Zoomed Feature Ablation Comparison\")\n",
    "plt.grid(axis=\"x\", alpha=0.3)\n",
    "plt.tight_layout()\n",
    "plt.show()"
