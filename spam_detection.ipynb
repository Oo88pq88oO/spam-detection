   "source": [
    "cv = StratifiedGroupKFold(\n",
    "    n_splits=5,\n",
    "    shuffle=True,\n",
    "    random_state=42\n",
    ")\n",
    "\n",
    "params = {\n",
    "    \"model__C\": [0.01, 0.1, 0.5, 1, 2, 5]\n",
    "}\n",
    "\n",
    "spam_f1 = make_scorer(\n",
    "    f1_score,\n",
    "    pos_label=\"spam\"\n",
    ")\n",
    "\n",
    "exp = {\n",
    "    \"TF_IDF Only\": [],\n",
    "    **{\n",
    "        f\"TF_IDF + {feature}\": [feature]\n",
    "        for feature in features\n",
    "    },\n",
    "\n",
    "    \"All_feature\": features,\n",
    "\n",
    "    **{\n",
    "        f\"without {feature}\": [\n",
    "            f for f in features if f != feature\n",
    "        ]\n",
    "        for feature in features\n",
    "    }\n",
    "}\n",
    "results = []\n",
    "\n",
    "\n",
    "for name, selected_features in exp.items():\n",
    "\n",
    "    transformers = [\n",
    "        (\n",
    "            \"text\",\n",
    "            TfidfVectorizer(\n",
    "                stop_words=\"english\",\n",
    "                ngram_range=(1, 2),\n",
    "                min_df=5,\n",
    "                max_df=0.95\n",
    "            ),\n",
    "            \"Message\"\n",
    "        )\n",
    "    ]\n",
    "\n",
    "    if selected_features:\n",
    "        transformers.append(\n",
    "            (\n",
    "                \"numeric\",\n",
    "                MinMaxScaler(),\n",
    "                selected_features\n",
    "            )\n",
    "        )\n",
    "\n",
    "    preprocessor = ColumnTransformer(transformers)\n",
    "\n",
    "    pipeline = Pipeline([\n",
    "        (\"preprocessor\", preprocessor),\n",
    "        (\n",
    "            \"model\",\n",
    "            LinearSVC(\n",
    "                class_weight=\"balanced\",\n",
    "                random_state=42\n",
    "            )\n",
    "        )\n",
    "    ])\n",
    "\n",
    "    grid = GridSearchCV(\n",
    "        pipeline,\n",
    "        params,\n",
    "        cv=cv,\n",
    "        scoring=spam_f1,\n",
    "        n_jobs=1\n",
    "    )\n",
    "\n",
    "    grid.fit(X_train, y_train, groups=X_train[\"Message\"])\n",
    "    best_index = grid.best_index_\n",
    "\n",
    "    fold_scores = [\n",
    "        grid.cv_results_[f\"split{i}_test_score\"][best_index]\n",
    "        for i in range(5)\n",
    "    ]\n",
    "    results.append({\n",
    "        \"Experiment\": name,\n",
    "        \"F1\": grid.best_score_,\n",
    "        \"Std\": grid.cv_results_[\"std_test_score\"][\n",
    "            grid.best_index_\n",
    "        ],\n",
    "        \"Best C\": grid.best_params_[\"model__C\"],\n",
    "        \"Fold Scores\": fold_scores\n",
    "    })\n",
    "\n",
    "    print(\n",
    "        f\"{name}: \"\n",
    "        f\"F1={grid.best_score_:.5f}, \"\n",
    "        f\"C={grid.best_params_['model__C']}\"\n",
    "    )\n",
    "\n",
    "\n",
    "results_df = pd.DataFrame(results).set_index(\"Experiment\")\n",
    "\n",
    "display(results_df.sort_values(\"F1\", ascending=False))\n"
   ]
  },
